# ── Promptly environment variables ──────────────────────────────────────────
# Copy to .env (local) or set in Render (production). Secrets only — no
# hardcoded values in the codebase.
#
# Local dev with docker-compose: the DB/S3 hosts below match the compose
# service names (db, minio). Without docker, point them at your own
# PostgreSQL / MinIO instance.

# PostgreSQL (Render Managed PostgreSQL / local docker-compose)
DATABASE_URL="postgresql://postgres:postgres@db:5432/promptly"

# Clerk authentication
# https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"

# S3-compatible storage (AWS S3 / Cloudflare R2 / Backblaze B2 / MinIO)
S3_ENDPOINT="http://minio:9000"
S3_REGION="auto"
S3_BUCKET="promptly"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_PUBLIC_URL="http://minio:9000/promptly"

# Modal GPU worker (https://modal.com)
MODAL_API_KEY="ak-xxx"
MODAL_API_URL="https://api.modal.com/v1"
MODAL_ENV_ID="your-modal-env-id"
MODAL_APP_NAME="promptly-worker"
MODAL_FUNCTION_NAME="generate_batch"
MODAL_AUTH_RELAY_SECRET="generate-a-long-random-string"

# App origin (used for absolute URLs, webhooks, OAuth redirects)
NEXT_PUBLIC_APP_URL="http://app-host:3000"

# Batch queue tuning (optional, defaults match the spec)
QUEUE_MAX_BATCH_SIZE="10"
QUEUE_MAX_WAIT_MS="180000"

# Free tier limits (optional)
FREE_DAILY_GENERATION_LIMIT="20"
FREE_MAX_QUEUED_JOBS="2"
